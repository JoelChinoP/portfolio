---
import type { Project } from "@/types/project";
import Github from "lucide-static/icons/github.svg";
import Globe from "lucide-static/icons/globe.svg";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const statusLabel = project.status === "completed" ? "Entregado" : "En curso";
const projectNumber = (index + 1).toString().padStart(2, "0");
---

<article
  class={`project-card project-card--${index}`}
  style={`--project-color: ${project.color}; --project-delay: ${index * 80}ms;`}
  data-project-card
  data-title={project.title}
  data-description={project.description}
  data-image={project.image}
  data-tags={project.tags.join("|")}
  data-status={statusLabel}
  data-github={project.github ?? ""}
  data-demo={project.demo ?? ""}
  tabindex="0"
  role="button"
  aria-haspopup="dialog"
  aria-label={`Ver detalles de ${project.title}`}
>
  <div class="project-card__media" aria-hidden="true">
    <img src={project.image} alt="" loading="lazy" />
  </div>
  <div class="project-card__wash" aria-hidden="true"></div>
  <div class="project-card__corner" aria-hidden="true"></div>

  <div class="project-card__content">
    <div class="project-card__meta">
      <span>{projectNumber} / CASE STUDY</span>
      <span class:list={["project-card__status", project.status === "in-progress" && "project-card__status--active"]}>
        <i></i>{statusLabel}
      </span>
    </div>

    <div class="project-card__body">
      <div class="project-card__icon" style={`background-color: ${project.color};`}>
        <project.icon />
      </div>
      <div>
        <h3>{project.title}</h3>
        <p>{project.description}</p>
      </div>
    </div>

    <div class="project-card__footer">
      <div class="project-card__tags" aria-label={`Tecnologías de ${project.title}`}>
        {
          project.tags.slice(0, 3).map((tag) => (
            <span>{tag}</span>
          ))
        }
      </div>

      <div class="project-card__links">
        {
          project.github && (
            <a
              href={project.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Ver código de ${project.title} en GitHub`}
            >
              <Github />
              <span>Código</span>
            </a>
          )
        }
        {
          project.demo && (
            <a
              href={project.demo}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Ver demo de ${project.title}`}
            >
              <Globe />
              <span>Demo</span>
            </a>
          )
        }
      </div>
    </div>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    grid-column: span 4;
    grid-row: span 2;
    min-height: 13.2rem;
    overflow: hidden;
    border: 1px solid rgba(187, 230, 248, 0.3);
    border-radius: 1.45rem;
    background: rgba(8, 23, 33, 0.62);
    box-shadow: 0 18px 38px rgba(0, 0, 0, 0.2);
    isolation: isolate;
    opacity: 0;
    animation: project-reveal 0.7s cubic-bezier(0.22, 1, 0.36, 1) var(--project-delay) forwards;
    cursor: pointer;
    transition: border-color 300ms ease, box-shadow 300ms ease, transform 300ms ease;
  }

  .project-card::after {
    position: absolute;
    top: 0;
    left: 0;
    width: 2.8rem;
    height: 2px;
    content: "";
    background: var(--project-color);
    transition: width 300ms ease;
  }

  .project-card:hover {
    z-index: 2;
    border-color: rgba(181, 237, 255, 0.55);
    box-shadow: 0 28px 58px rgba(0, 0, 0, 0.42);
    transform: translateY(-4px);
  }

  .project-card:focus-visible {
    z-index: 2;
    border-color: #b6edff;
    outline: 2px solid #b6edff;
    outline-offset: 3px;
  }

  .project-card:hover::after {
    width: 7rem;
  }

  .project-card__media,
  .project-card__wash {
    position: absolute;
    inset: 0;
  }

  .project-card__media {
    z-index: -3;
  }

  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.88) contrast(1.02) brightness(0.76);
    transform: scale(1.02);
    transition: filter 500ms ease, transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-card:hover .project-card__media img {
    filter: saturate(1.03) contrast(1.02) brightness(0.9);
    transform: scale(1.08);
  }

  .project-card__wash {
    z-index: -2;
    background:
      linear-gradient(108deg, rgba(5, 12, 19, 0.84) 0%, rgba(5, 12, 19, 0.56) 47%, rgba(5, 12, 19, 0.08) 100%),
      linear-gradient(to top, rgba(5, 12, 19, 0.68), transparent 62%);
  }

  .project-card__corner {
    position: absolute;
    right: -2.8rem;
    bottom: -2.8rem;
    z-index: -1;
    width: 8.5rem;
    height: 8.5rem;
    border: 1px solid color-mix(in srgb, var(--project-color) 68%, transparent);
    border-radius: 50%;
    opacity: 0.8;
    transition: transform 500ms ease;
  }

  .project-card:hover .project-card__corner {
    transform: scale(1.18);
  }

  .project-card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    padding: 1.15rem;
  }

  .project-card__meta,
  .project-card__footer,
  .project-card__links,
  .project-card__tags,
  .project-card__body {
    display: flex;
    align-items: center;
  }

  .project-card__meta {
    justify-content: space-between;
    gap: 0.7rem;
    color: #b5ccda;
    font-size: 0.57rem;
    letter-spacing: 0.11em;
  }

  .project-card__status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #a9dceb;
    white-space: nowrap;
  }

  .project-card__status i {
    display: block;
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 50%;
    background: #9ee9c0;
    box-shadow: 0 0 0.6rem rgba(158, 233, 192, 0.7);
  }

  .project-card__status--active i {
    background: #f5c56e;
    box-shadow: 0 0 0.6rem rgba(245, 197, 110, 0.7);
  }

  .project-card__body {
    align-items: flex-start;
    gap: 0.8rem;
    margin-top: 1rem;
  }

  .project-card__icon {
    display: grid;
    flex: 0 0 auto;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    color: #e7f7ff;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.24);
  }

  .project-card__icon :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }

  .project-card h3 {
    max-width: 30rem;
    margin: -0.08rem 0 0;
    color: #f0f8fb;
    font-size: clamp(1.3rem, 1.8vw, 1.75rem);
    line-height: 0.96;
  }

  .project-card__body p {
    display: -webkit-box;
    max-width: 34rem;
    margin: 0.52rem 0 0;
    overflow: hidden;
    color: #bdced8;
    font-size: 0.7rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .project-card__footer {
    justify-content: space-between;
    gap: 0.8rem;
    margin-top: auto;
    padding-top: 1rem;
  }

  .project-card__tags {
    min-width: 0;
    gap: 0.35rem;
    overflow: hidden;
  }

  .project-card__tags span {
    overflow: hidden;
    max-width: 7.4rem;
    padding: 0.28rem 0.38rem;
    border: 1px solid rgba(180, 229, 248, 0.16);
    color: #c2dce8;
    font-size: 0.54rem;
    letter-spacing: 0.03em;
    text-overflow: ellipsis;
    white-space: nowrap;
    background: rgba(10, 25, 35, 0.48);
  }

  .project-card__links {
    flex: 0 0 auto;
    gap: 0.35rem;
  }

  .project-card__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.38rem;
    border: 1px solid rgba(188, 237, 255, 0.24);
    color: #e1f6ff;
    font-size: 0.56rem;
    text-decoration: none;
    background: rgba(10, 25, 35, 0.5);
    transition: background 220ms ease, border-color 220ms ease;
  }

  .project-card__links a:hover {
    border-color: #b6edff;
    background: rgba(28, 110, 149, 0.5);
  }

  .project-card__links :global(svg) {
    width: 0.76rem;
    height: 0.76rem;
  }

  .project-card--0 {
    grid-column: span 7;
    grid-row: span 4;
    border-radius: 2rem 1.25rem 2rem 1.25rem;
  }

  .project-card--0 .project-card__content {
    max-width: 72%;
    padding: 1.55rem;
  }

  .project-card--0 h3 {
    font-size: clamp(2rem, 3.2vw, 3.2rem);
  }

  .project-card--0 .project-card__body p {
    font-size: 0.77rem;
    -webkit-line-clamp: 3;
  }

  .project-card--1,
  .project-card--2 {
    grid-column: span 5;
    grid-row: span 2;
  }

  .project-card--3,
  .project-card--4,
  .project-card--5 {
    grid-column: span 4;
    grid-row: span 2;
  }

  .project-card--6 {
    grid-column: span 12;
    grid-row: span 2;
    border-radius: 1.25rem 2rem 1.25rem 2rem;
  }

  .project-card--6 .project-card__content {
    max-width: 62%;
  }

  @keyframes project-reveal {
    from {
      opacity: 0;
      transform: translateY(1.2rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 1023px) {
    .project-card,
    .project-card--0,
    .project-card--1,
    .project-card--2,
    .project-card--3,
    .project-card--4,
    .project-card--5,
    .project-card--6 {
      grid-column: span 1;
      grid-row: auto;
      min-height: 21rem;
    }

    .project-card--0,
    .project-card--6 {
      grid-column: span 2;
    }

    .project-card--0 .project-card__content,
    .project-card--6 .project-card__content {
      max-width: 72%;
    }
  }

  @media (max-width: 639px) {
    .project-card,
    .project-card--0,
    .project-card--6 {
      grid-column: span 1;
      min-height: 22rem;
    }

    .project-card__content,
    .project-card--0 .project-card__content,
    .project-card--6 .project-card__content {
      max-width: 100%;
      padding: 1.15rem;
    }

    .project-card--0 h3 {
      font-size: clamp(2rem, 9vw, 2.7rem);
    }

    .project-card__footer {
      align-items: flex-end;
    }

    .project-card__tags span:nth-child(n + 3) {
      display: none;
    }
  }
</style>
