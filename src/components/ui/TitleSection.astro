---
const { title } = Astro.props as { title: string };
---

<div class="section-title text-center mb-10">
  <p class="section-title__eyebrow">ARCHIVO PERSONAL</p>
  <h2
    class="font-display text-5xl text-slate-100 sm:text-6xl inline-block"
  >
    {title}
  </h2>
  <div
    class="section-title__rule mx-auto mt-5"
  >
  </div>
</div>

<style>
  .section-title__eyebrow {
    margin-bottom: 0.85rem;
    color: #7dd3fc;
    font-size: 0.66rem;
    letter-spacing: 0.18em;
  }

  .section-title__rule {
    width: 4.5rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, #7dd3fc, transparent);
  }
</style>
