---
import Github from "lucide-static/icons/github.svg";
import Linkedin from "lucide-static/icons/linkedin.svg";
import Mail from "lucide-static/icons/mail.svg";
import ArrowDown from "lucide-static/icons/circle-arrow-down.svg";
import CodeIlustration from "@/assets/coding-ilu.svg";

const socialLinks = [
  {
    url: "https://github.com/JoelChinoP",
    icon: Github,
    label: "GitHub",
  },
  {
    url: "https://www.linkedin.com/in/joel-antonio-chino-pari-6184a22b4",
    icon: Linkedin,
    label: "LinkedIn",
  },
  {
    url: "mailto:joel15acp@gmail.com",
    icon: Mail,
    label: "Correo",
  },
];
---

<section
  id="home"
  class="relative flex min-h-screen items-center overflow-hidden px-5 pt-20 xl:px-[9%]"
>
  <div
    class="hero-layout relative z-10 grid w-full max-w-7xl mx-auto items-center gap-12 py-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20"
  >
    <div class="flex flex-col items-start">
      <div
        class="hero-availability flex w-fit items-center gap-3 animate-fade-in-up"
      >
        <div class="relative size-4">
          <div
            class="absolute size-full animate-ping rounded-full bg-green-300 opacity-65"
          >
          </div>
          <div
            class="size-full rounded-full bg-green-400 drop-shadow-[0_0_4px_rgba(34,197,94,0.75)]"
          >
          </div>
        </div>
        <p class="text-xs text-cyan-100 font-medium tracking-[0.1em]">
          Disponible para proyectos
        </p>
      </div>

      <p class="hero-kicker animate-fade-in-up delay-150">01 / SOFTWARE ENGINEER</p>
      <h1
        class="font-display mt-5 max-w-2xl text-5xl leading-[0.94] text-slate-100 sm:text-6xl md:text-7xl animate-fade-in-up delay-150"
      >
        Construyo software que <span class="hero-signal">resuelve.</span>
      </h1>
      <h2
        class="mt-6 text-sm sm:text-base text-cyan-200 animate-fade-in-up delay-300"
      >
        <span id="text-animate" class="text-blue-300"></span>
      </h2>
      <p
        class="mt-5 max-w-xl text-sm leading-7 text-slate-300 sm:text-base animate-fade-in-up delay-300"
      >
        Soy Joel Chino. Diseño sistemas backend limpios, eficientes y preparados
        para convertir retos complejos en productos que sí funcionan.
      </p>
      <div class="mt-8 flex gap-3 animate-fade-in-up delay-500 flex-wrap">
        {
          socialLinks.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.label}
              class="hero-social group flex h-11 w-11 justify-center items-center text-cyan-100 transition-all duration-300 hover:text-white"
            >
              <div class="w-6 h-6">
                <link.icon class="w-full h-full transition-all duration-300 group-hover:scale-105 group-hover:drop-shadow-[0_0_8px_rgba(59,130,246,0.7)]" />
              </div>
            </a>
          ))
        }
        <a
          href="#projects"
          class="hero-cta group flex items-center gap-3 px-5 py-3 text-xs font-medium tracking-[0.08em] text-slate-950 transition-all duration-300"
        >
          <span>EXPLORAR PROYECTOS</span>
          <ArrowDown
            class="w-5 h-5 transition-transform duration-300 group-hover:translate-y-1 group-hover:scale-110 group-hover:drop-shadow-[0_2px_8px_rgba(59,130,246,0.7)]"
          />
        </a>
      </div>
    </div>

    <div class="hero-visual relative flex justify-center items-center animate-fade-in-up delay-700">
      <div class="hero-coordinate hero-coordinate--top">AREQUIPA / PE</div>
      <div class="hero-coordinate hero-coordinate--bottom">SYSTEMS ONLINE</div>
      <div
        class="hero-orbit relative flex h-64 w-64 items-center justify-center overflow-hidden sm:h-96 sm:w-96"
      >
        <img
          src={CodeIlustration.src}
          alt="Ilustración de programación"
          class="relative z-10 h-56 w-56 object-contain drop-shadow-xl sm:h-80 sm:w-80 animate-float"
        />
        <span
          class="absolute -inset-3 rounded-full border border-cyan-300/35 animate-pulse"
        ></span>
      </div>
    </div>
  </div>

  <style>
    @keyframes fade-in-up {
      0% {
        opacity: 0;
        transform: translateY(40px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .animate-fade-in-up {
      animation: fade-in-up 1s cubic-bezier(0.4, 0, 0.2, 1) both;
    }
    .delay-150 {
      animation-delay: 0.15s;
    }
    .delay-300 {
      animation-delay: 0.3s;
    }
    .delay-500 {
      animation-delay: 0.5s;
    }
    .delay-700 {
      animation-delay: 0.7s;
    }

    @keyframes float {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-20px);
      }
    }
    .animate-float {
      animation: float 3s ease-in-out infinite;
    }

    .hero-availability {
      padding: 0.48rem 0.78rem;
      border: 1px solid rgba(125, 211, 252, 0.28);
      background: rgba(10, 22, 32, 0.58);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.16);
      backdrop-filter: blur(12px);
    }

    .hero-kicker {
      margin-top: 2rem;
      color: #7dd3fc;
      font-size: 0.72rem;
      letter-spacing: 0.17em;
    }

    .hero-signal {
      color: #7dd3fc;
      font-style: italic;
    }

    .hero-social {
      border: 1px solid rgba(125, 211, 252, 0.22);
      background: rgba(9, 21, 30, 0.58);
      backdrop-filter: blur(10px);
    }

    .hero-social:hover {
      border-color: rgba(165, 231, 255, 0.78);
      background: rgba(22, 89, 122, 0.36);
      transform: translateY(-3px);
    }

    .hero-cta {
      border: 1px solid #b6edff;
      background: #b6edff;
      box-shadow: 0 8px 30px rgba(125, 211, 252, 0.18);
    }

    .hero-cta:hover {
      background: transparent;
      color: #b6edff;
      transform: translateY(-3px);
    }

    .hero-visual::before,
    .hero-visual::after {
      position: absolute;
      content: "";
      width: min(88vw, 32rem);
      aspect-ratio: 1;
      border: 1px solid rgba(125, 211, 252, 0.14);
      transform: rotate(22deg);
    }

    .hero-visual::before {
      border-radius: 42% 58% 63% 37% / 41% 40% 60% 59%;
    }

    .hero-visual::after {
      width: min(70vw, 25rem);
      border-radius: 58% 42% 32% 68% / 57% 57% 43% 43%;
      transform: rotate(-19deg);
    }

    .hero-orbit {
      border: 1px solid rgba(125, 211, 252, 0.36);
      background: radial-gradient(circle at 50% 40%, rgba(36, 131, 177, 0.18), rgba(7, 11, 17, 0.28) 66%);
      box-shadow: inset 0 0 70px rgba(11, 98, 148, 0.14), 0 30px 70px rgba(0, 0, 0, 0.32);
    }

    .hero-coordinate {
      position: absolute;
      z-index: 20;
      color: rgba(196, 235, 255, 0.7);
      font-size: 0.6rem;
      letter-spacing: 0.15em;
    }

    .hero-coordinate--top {
      top: 2%;
      right: 4%;
    }

    .hero-coordinate--bottom {
      bottom: 2%;
      left: 4%;
    }

    @media (max-width: 1023px) {
      .hero-visual {
        min-height: 22rem;
      }
    }

    @media (max-width: 639px) {
      .hero-coordinate {
        font-size: 0.52rem;
      }
    }
  </style>

  <script>
    function setupTextAnimation() {
      const textElement = document.getElementById("text-animate");
      if (!textElement) return;

      const text = "Desarrollador de Software | Backend & Más";
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        textElement.textContent = text;
        return;
      }
      let charIndex = 0;
      let isTyping = true;

      function typeText() {
        if (isTyping) {
          if (charIndex < text.length) {
            textElement.textContent += text.charAt(charIndex);
            charIndex++;
            setTimeout(typeText, 70);
          } else {
            isTyping = false;
            setTimeout(typeText, 1800);
          }
        } else {
          if (charIndex > 0) {
            textElement.textContent = text.substring(0, charIndex - 1);
            charIndex--;
            setTimeout(typeText, 30);
          } else {
            isTyping = true;
            setTimeout(typeText, 800);
          }
        }
      }
      setTimeout(typeText, 800);
    }

    document.addEventListener("DOMContentLoaded", () => {
      setupTextAnimation();
    });
  </script>
</section>
